# Lumen documentation MVP note generation
# Use "fake" for local/dev deterministic output or "huggingface" for HF Router.
NOTE_GENERATOR=fake
HF_TOKEN=your_huggingface_token_here
HF_BASE_URL=https://router.huggingface.co/v1
HF_LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct

# Cheaper/dev testing:
# HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Strong structured JSON behavior:
# HF_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# Mistral instruct fallback, subject to current Hugging Face provider availability:
# HF_LLM_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
